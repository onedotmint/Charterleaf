{
  "name": "@onedotmint/charterleaf",
  "version": "0.4.2",
  "description": "Lightweight Agent-Native Constraint Layer: opt-in spec discovery and maintenance for Pi, with a standalone zero-dependency CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onedotmint/charterleaf.git"
  },
  "homepage": "https://github.com/onedotmint/charterleaf#readme",
  "bugs": {
    "url": "https://github.com/onedotmint/charterleaf/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "charterleaf": "./bin/charterleaf.js"
  },
  "files": [
    "bin/",
    "lib/",
    "extensions/",
    "skills/",
    "templates/",
    "AGENTS_SNIPPET.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "charterleaf",
    "ai-agent",
    "coding-agent",
    "specification",
    "agent-skills",
    "pi",
    "pi-package"
  ],
  "scripts": {
    "test": "node --test",
    "test:package": "node scripts/package-smoke.js",
    "test:pi": "node scripts/pi-smoke.js",
    "test:organic": "node scripts/organic-smoke.js",
    "test:context": "node scripts/context-smoke.js"
  },
  "pi": {
    "extensions": [
      "./extensions/charterleaf.js"
    ],
    "skills": [
      "./skills"
    ]
  }
}
